# Base URL for the guestbook backend (fg-tamagochi, Go/Chi). See docs/api-contract.md.
# Defaults to /api/v1 (same-origin) if unset. Also read by docker-compose.yml as a
# BUILD arg (see docs/deployment.md) — Vite inlines this into the JS bundle at build
# time, so changing it later needs a rebuild, not just a container restart.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Host port docker-compose.yml maps to the container's nginx (port 80). Only read by
# docker compose, not by Vite. See docs/deployment.md.
WEB_PORT=8081
